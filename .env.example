# Leave empty to run in clearly labelled demo mode (no backend calls).
# Dev (via the Vite proxy in vite.config.js, no CORS setup needed):
VITE_N8N_WEBHOOK_URL=/n8n/webhook/YOUR-WEBHOOK-ID/chat
# Production: use your HTTPS proxy URL, e.g. https://api.yourdomain.com/oest/chat

# Server-side only (used by the Vite dev proxy, never sent to the browser)
N8N_BASE_URL=http://localhost:5678
